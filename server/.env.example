# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/customer_review_rating_system?retryWrites=true&w=majority

# Redis (cache only)
REDIS_URL=redis://localhost:6379

# JWT (added when the auth module is implemented)
# JWT_SECRET=
# JWT_EXPIRES_IN=15m
