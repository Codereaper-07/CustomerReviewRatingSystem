# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/customer_review_rating_system?retryWrites=true&w=majority

# Redis (cache only)
REDIS_URL=redis://localhost:6379

# JWT auth
# Required — there is no default/hardcoded secret. Generate a strong,
# random value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real secret.
JWT_SECRET=
JWT_EXPIRES_IN=15m
AUTH_COOKIE_NAME=auth_token

# Login rate limiting (in-memory via express-rate-limit — NOT Redis)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
